--[[
	Creature spawns and guardian encounters from map markers (milestone 4). Server only.

	Markers (CollectionService tags, see README "Placing encounters and camps"):
	  HB_CreatureSpawn  BasePart. Attributes:
	      Variant        "Regular" (default) or "Guardian"
	      EncounterId    required for guardians; links to a cache
	      RespawnSeconds optional override of the variant's respawnSeconds
	  HB_RelicCache     BasePart. Attribute EncounterId (matches a guardian spawn).

	Regular spawns: one creature each; after it is defeated or lost, a new one appears
	after RespawnSeconds.

	Guardian encounters (EncounterCore): the cache is locked while the guardian lives.
	When it falls, exactly one reward specimen is generated by SpecimenFactory (weighted
	pick from Config.Encounters.RewardTable) and placed on the cache as a normal world
	relic: the first successful pickup owns it, never automatically the last hitter. Its
	ID and traits then follow the usual relic rules (drops, recovery, registration).
	After the reward is claimed, the encounter resets after RespawnSeconds. Players
	leaving never resets an encounter. A guardian lost to the environment gives no reward
	and resets after Config.Encounters.LostGuardianResetSeconds.
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HollowboundShared"):WaitForChild("Config"))
local Creatures = require(script.Parent.Creatures)
local EncounterCore = require(script.Parent.EncounterCore)
local RelicStore = require(script.Parent.RelicStore)
local ServerNet = require(script.Parent.ServerNet)
local SpecimenFactory = require(script.Parent.SpecimenFactory)
local WorldRelics = require(script.Parent.WorldRelics)

local Encounters = {}

local store
local rng = Random.new()
local spawners = {} -- regular: { marker, creature, respawnAt }
local encounters = {} -- [encounterId] = { core, marker, cache, creature, lockLabel }

local function standPoint(marker: BasePart): Vector3
	return marker.Position + Vector3.new(0, marker.Size.Y / 2, 0)
end

local function respawnSeconds(marker: BasePart, variant: string): number
	local override = marker:GetAttribute("RespawnSeconds")
	return if typeof(override) == "number" and override >= 0 then override else Config.Creatures.Variants[variant].respawnSeconds
end

-- Cache lock label --------------------------------------------------------------------------

local function setCacheLocked(entry, locked: boolean)
	if not entry.cache then
		return
	end
	entry.cache:SetAttribute("Locked", locked)
	entry.lockLabel.Text = if locked then `Locked: defeat the {Config.Creatures.Variants.Guardian.displayName}` else "Unlocked"
	entry.lockLabel.TextColor3 = if locked then Color3.fromRGB(240, 120, 100) else Color3.fromRGB(140, 230, 150)
	entry.lockPrompt.Enabled = locked
end

local function prepareCache(entry)
	local cache = entry.cache
	local gui = Instance.new("BillboardGui")
	gui.Name = "HB_CacheLabel"
	gui.Size = UDim2.fromOffset(260, 30)
	gui.StudsOffset = Vector3.new(0, cache.Size.Y / 2 + 3.5, 0)
	gui.MaxDistance = 80
	gui.Parent = cache
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	entry.lockLabel = label

	-- Shown while locked, so players learn why they cannot open it.
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HB_CachePrompt"
	prompt.ActionText = "Inspect"
	prompt.ObjectText = "Relic cache (locked)"
	prompt.MaxActivationDistance = Config.Encounters.CachePromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = cache
	prompt.Triggered:Connect(function(player)
		if EncounterCore.isLocked(entry.core) then
			ServerNet.notify(player, `The cache is sealed while its {Config.Creatures.Variants.Guardian.displayName} lives.`, "error")
		end
	end)
	entry.lockPrompt = prompt
end

-- Guardian encounters -------------------------------------------------------------------------

local spawnGuardian

local function makeReward(entry): string?
	local pick = EncounterCore.pickReward(Config.Encounters.RewardTable, rng:NextNumber())
	local specimen = SpecimenFactory.create(pick.typeId, pick.qualityMin, pick.qualityMax, rng, function()
		return HttpService:GenerateGUID(false)
	end)
	store:add(specimen)
	local position = standPoint(entry.cache) + Vector3.new(0, 1.5, 0)
	WorldRelics.spawnReward(specimen, position)
	if Config.Dev.LogTraitsToServerOutput then
		print(`[Hollowbound] Encounter {entry.core.id} reward: {specimen.rarity} {RelicStore.fingerprint(specimen)}`)
	end
	return specimen.id
end

function spawnGuardian(entry)
	local cycle = EncounterCore.beginCycle(entry.core, os.clock())
	setCacheLocked(entry, true)
	local function attempt()
		if entry.core.cycle ~= cycle then
			return
		end
		local creature = Creatures.spawn("Guardian", standPoint(entry.marker), {
			onDefeated = function()
				local ok, rewardId = EncounterCore.guardianDefeated(entry.core, cycle, function()
					return makeReward(entry)
				end)
				if ok then
					setCacheLocked(entry, false)
					print(`[Hollowbound] Encounter {entry.core.id} cycle {cycle} unlocked; reward {rewardId}`)
				end
			end,
			onLost = function()
				if EncounterCore.guardianLost(entry.core, cycle, os.clock(), Config.Encounters.LostGuardianResetSeconds) then
					print(`[Hollowbound] Encounter {entry.core.id} cycle {cycle}: guardian lost, no reward`)
				end
			end,
		})
		if creature then
			entry.creature = creature
		else
			task.delay(2, attempt) -- creature budget full; try again shortly
		end
	end
	attempt()
end

local function addEncounter(marker: BasePart)
	local id = marker:GetAttribute("EncounterId")
	if typeof(id) ~= "string" or id == "" then
		warn(`[Hollowbound] Guardian spawn {marker:GetFullName()} has no EncounterId; skipped.`)
		return
	end
	if encounters[id] then
		warn(`[Hollowbound] Duplicate guardian EncounterId {id}; skipped {marker:GetFullName()}.`)
		return
	end
	local cache
	for _, candidate in CollectionService:GetTagged(Config.Tags.RelicCache) do
		if candidate:IsA("BasePart") and candidate:GetAttribute("EncounterId") == id then
			cache = candidate
		end
	end
	if not cache then
		warn(`[Hollowbound] No part tagged {Config.Tags.RelicCache} with EncounterId {id}; encounter skipped.`)
		return
	end
	local entry = { core = EncounterCore.new(id), marker = marker, cache = cache }
	prepareCache(entry)
	encounters[id] = entry
	spawnGuardian(entry)
end

-- Regular spawns ------------------------------------------------------------------------------

local function addSpawner(marker: BasePart)
	table.insert(spawners, { marker = marker, creature = nil, respawnAt = 0 })
end

local function tickSpawners(now: number)
	for _, spawner in spawners do
		if spawner.creature or now < spawner.respawnAt or not spawner.marker.Parent then
			continue
		end
		local creature = Creatures.spawn("Regular", standPoint(spawner.marker), {
			onDefeated = function()
				spawner.creature = nil
				spawner.respawnAt = os.clock() + respawnSeconds(spawner.marker, "Regular")
			end,
			onLost = function()
				spawner.creature = nil
				spawner.respawnAt = os.clock() + respawnSeconds(spawner.marker, "Regular")
			end,
		})
		if creature then
			spawner.creature = creature
		else
			spawner.respawnAt = now + 2 -- budget full
		end
	end
	for _, entry in encounters do
		if EncounterCore.resetDue(entry.core, now) and entry.core.state ~= "Guarded" then
			print(`[Hollowbound] Encounter {entry.core.id} resets`)
			spawnGuardian(entry)
		end
	end
end

function Encounters.start(theStore)
	store = theStore

	for _, marker in CollectionService:GetTagged(Config.Tags.CreatureSpawn) do
		if not marker:IsA("BasePart") then
			continue
		end
		local variant = marker:GetAttribute("Variant") or "Regular"
		if variant == "Guardian" then
			addEncounter(marker)
		elseif variant == "Regular" then
			addSpawner(marker)
		else
			warn(`[Hollowbound] Unknown creature Variant {variant} on {marker:GetFullName()}`)
		end
	end

	WorldRelics.onClaimed(function(player, specimenId)
		for _, entry in encounters do
			local respawn = respawnSeconds(entry.marker, "Guardian")
			if EncounterCore.rewardClaimed(entry.core, specimenId, os.clock(), respawn) then
				print(`[Hollowbound] {player.Name} claimed encounter {entry.core.id} reward; resets in {respawn} s`)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			tickSpawners(os.clock())
		end
	end)
end

return Encounters
